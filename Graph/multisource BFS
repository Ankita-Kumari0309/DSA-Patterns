import java.util.*;
class Main 
{
    public static void main(String[] args) 
    {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter no of vertices:");
        int V = sc.nextInt();
        System.out.println("Enter no of edges:");
        int E = sc.nextInt();
        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();
        for(int i = 0;i<V;i++)
        {
            adj.add(new ArrayList<>());
        }
        for(int i =0;i<E;i++)
        {
            int u = sc.nextInt();
            int v = sc.nextInt();
            adj.get(u).add(v);
            adj.get(v).add(u);
        }
        System.out.println("Enter  no of sources");
        int s = sc.nextInt();
        System.out.println("Enter tha all sources");
        int[] sources = new int[s];
        for(int i =0;i<s;i++)
        {
            sources[i] = sc.nextInt();
        }
        int[] dist = new int[V];
        multisourceBFS(adj,dist,sources,V);
    }
    public static void multisourceBFS(ArrayList<ArrayList<Integer>> adj, int[] dist,int[] sources,int V)
    {
        Queue<Integer> q = new LinkedList<>();
        Arrays.fill(dist,-1);
        for(int i =0 ;i<sources.length;i++)
        {
            q.offer(sources[i]);
            dist[sources[i]] = 0;// from sources the distance will be 0
        }
        while(!q.isEmpty())
        {
            int node = q.poll();
            for(int neigh : adj.get(node))
            {
                if(dist[neigh] == -1)
                {
                    q.offer(neigh);
                    dist[neigh] = dist[node]+1;
                }
            }
        }
        System.out.println("The shortes pathe from nodes");
        for(int i =0;i<V;i++)
        {
            System.out.println("Node "+i+"->"+dist[i]);
        }
    }
}

